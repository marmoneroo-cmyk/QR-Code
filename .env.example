# ---------------------------------------------------------------------------
# Environment template — copy to .env.local and fill with real values.
# .env.local is gitignored and must NEVER be committed.
# Do NOT put real secrets in this file; placeholders only.
# ---------------------------------------------------------------------------

# Supabase — project URL (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase — anon/publishable key (public, RLS-protected, safe in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — service_role key (SECRET, full DB access, server-only — NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth enforcement — when 'true', middleware gates /admin/* behind login (/admin/login).
# Leave OFF until an owner user + a restaurant_members row exist, or you'll lock
# yourself out. See docs/saas-foundation. Default (unset) = admin stays open.
AUTH_ENFORCED=false

# Direct Postgres connection (pooler) — SECRET. For migrations / psql / direct SQL only;
# the app itself uses the Supabase client above, not this. Get the URI from
# Settings → Database → Connection string. The password must be the CURRENT (rotated)
# DB password — and a real connection string must NEVER be pasted in chat / commits / issues.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres

# Google Gemini — breakdown generation (SECRET)
GEMINI_API_KEY=your-gemini-api-key

# Hugging Face — inference token (SECRET, optional)
HF_TOKEN=your-hf-token

# Pollinations.ai — AI image generation (all OPTIONAL; without any token the menu
# import + editor fall back to a placeholder + manual upload).
# Create an API key (sk_...) at https://enter.pollinations.ai (Keys → + API Key).
#
# SERVER-ONLY secret — used by /api/import-restaurant via an Authorization: Bearer
# header. NOT exposed to the browser. Prefer this. (sk_ keys must stay secret.)
POLLINATIONS_TOKEN=your-pollinations-sk-key
# Image model. Default 'turbo' (free Seed tier). 'flux' is higher quality but needs
# the paid Flower tier (returns HTTP 402 on the free tier).
POLLINATIONS_MODEL=turbo
# Public token for the CLIENT-side editor generator only (exposed in the browser
# bundle). Leave unset unless you need in-editor generation; the import route does
# NOT need this.
NEXT_PUBLIC_POLLINATIONS_TOKEN=your-pollinations-token
